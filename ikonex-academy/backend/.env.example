# ==========================================
# SERVER CONFIG
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="mysql://user:password@localhost:3306/ikonex_academy"

# ==========================================
# JWT AUTH
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# FRONTEND URL (CORS)
# ==========================================
FRONTEND_URL=http://localhost:3000

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==========================================
# SCHOOL INFO (for reports)
# ==========================================
SCHOOL_NAME=Ikonex Academy
SCHOOL_ADDRESS=P.O. Box 1234, Nairobi, Kenya
SCHOOL_PHONE=+254 700 000 000
SCHOOL_EMAIL=info@ikonexacademy.com
SCHOOL_MOTTO=Excellence Through Knowledge
