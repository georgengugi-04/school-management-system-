generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(TEACHER)
  isActive  Boolean  @default(true)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

model ClassStream {
  id          String   @id @default(cuid())
  name        String   @unique
  level       Int
  stream      String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  students      Student[]
  classSubjects ClassSubject[]
  assessments   Assessment[]
  @@map("class_streams")
}

model Student {
  id              String      @id @default(cuid())
  admissionNumber String      @unique
  firstName       String
  lastName        String
  gender          Gender
  dateOfBirth     DateTime
  parentName      String
  parentPhone     String
  email           String?
  address         String?
  photo           String?
  isActive        Boolean     @default(true)
  admissionDate   DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  classStreamId   String
  classStream     ClassStream @relation(fields: [classStreamId], references: [id])
  assessments     Assessment[]
  @@map("students")
}

enum Gender {
  MALE
  FEMALE
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  classSubjects ClassSubject[]
  assessments   Assessment[]
  @@map("subjects")
}

model ClassSubject {
  id            String      @id @default(cuid())
  classStreamId String
  subjectId     String
  createdAt     DateTime    @default(now())
  classStream   ClassStream @relation(fields: [classStreamId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([classStreamId, subjectId])
  @@map("class_subjects")
}

model Assessment {
  id           String  @id @default(cuid())
  catScore     Float   @default(0)
  examScore    Float   @default(0)
  total        Float   @default(0)
  grade        String?
  remarks      String?
  term         Term
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  studentId     String
  subjectId     String
  classStreamId String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id])
  classStream   ClassStream @relation(fields: [classStreamId], references: [id])
  @@unique([studentId, subjectId, term, academicYear])
  @@map("assessments")
}

enum Term {
  TERM_1
  TERM_2
  TERM_3
}

model GradingScale {
  id        String   @id @default(cuid())
  grade     String   @unique
  minScore  Float
  maxScore  Float
  remarks   String
  points    Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("grading_scales")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String?
  description String
  userId      String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  @@map("activity_logs")
}
